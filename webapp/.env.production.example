RUNTIME_PLATFORM=aliyun
APP_ENV=production
SEMANTIC_PROVIDER=deepseek-judge
DEEPSEEK_API_KEY=replace-with-a-new-server-side-key
DEEPSEEK_MODEL=deepseek-v4-flash
ADMIN_API_TOKEN=replace-with-a-long-random-admin-token
AUTH_SECRET=replace-with-at-least-32-random-characters
# Username/password/recovery-code login works without SMS configuration.
# Fill all four SMS values only after the Alibaba Cloud signature and template are approved.
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
DATABASE_PATH=/data/guess-word.sqlite
HOSTNAME=0.0.0.0
PORT=3000
APP_BIND_ADDRESS=0.0.0.0
APP_HOST_PORT=80
