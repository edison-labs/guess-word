# Required runtime mode: development, test, or production.
APP_ENV=development

# Choose explicitly. deterministic is allowed only in development/test.
SEMANTIC_PROVIDER=deterministic

# Optional deterministic development fixture. Never expose this through an API.
TEST_QUESTION_ID=
AUTH_SECRET=development-only-auth-secret-change-me
TEST_SMS_CODE=123456

# Required only when SEMANTIC_PROVIDER=cloudflare-ai.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/baai/bge-m3

# Required only when SEMANTIC_PROVIDER=deepseek-judge.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
